# Google Calendar ID (usually your Gmail address)
CALENDAR_ID=your-email@gmail.com

# Base URL where this app is accessible from your phone
# Examples:
#   Local development: http://localhost:8000
#   Tailscale: http://your-machine-name:8000
#   ngrok: https://abc123.ngrok-free.app
BASE_URL=http://localhost:8000

# Hour of day (0-23) to schedule watering reminders
REMINDER_HOUR=9
